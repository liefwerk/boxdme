TMDB_API_KEY=your_tmdb_api_key_here

# Only this Letterboxd username is saved to boxdme.sqlite3, and kept indefinitely. Leave empty for session-only (no disk watchlists).
PERSIST_USERNAME=liefwerk

# Remove in-memory guest sessions after this many hours without use (the PERSIST_USERNAME data is never purged).
WATCHLIST_RETENTION_HOURS=24
